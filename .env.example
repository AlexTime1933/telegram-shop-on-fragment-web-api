# Copy to .env (in this folder) and fill in. .env is git-ignored.
# Every secret can be written inline (NAME=value) or as a file (NAME_FILE=path).
# Relative paths are resolved against this folder. Examples of files: config_examples/

# --- Fragment session: cookies of a browser logged in to fragment.com ---
# JSON file {"stel_ssid": "...", "stel_token": "...", "stel_ton_token": "...", "stel_dt": "..."}
FRAGMENT_COOKIES_FILE=cookie.json
# or inline:  FRAGMENT_COOKIES=stel_ssid=...; stel_token=...; stel_ton_token=...; stel_dt=-180

# --- TON wallet linked to Fragment ---
# Seed phrase: 12-word BIP39 or 24-word TON, words separated by spaces
TON_MNEMONIC=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12
# or a file:  TON_MNEMONIC_FILE=seed.txt
# TON_MNEMONIC_PASSWORD=
# v5r1 (W5, default in Tonkeeper) or v4r2
TON_WALLET_VERSION=v5r1
TON_NETWORK=mainnet

# --- tonapi.io key from tonconsole.com ---
TONAPI_KEY=AE...
# or a file:  TONAPI_KEY_FILE=tonconsole_api

# How the bot pays Fragment: usdt_ton = USDT on TON from the same wallet (default), ton = TON.
# With usdt_ton the wallet needs USDT for the price plus a little TON (~0.05 per purchase) for gas.
FRAGMENT_PAYMENT_METHOD=usdt_ton

# --- safety ---
# Hard limit per single purchase in TON / in USDT ("off" to disable)
FRAGMENT_MAX_PURCHASE_TON=100
FRAGMENT_MAX_PURCHASE_USDT=100
# Comma separated addresses Fragment may ask to pay ("any" disables the check).
# Default: Fragment's wallets UQCFJEP4WZ_mpdo0_kMEmsTgvrMHG7K_tWY16pQhKHwoOtFz (Stars)
# and EQBAjaOyi2wGWlk-EDkSabqqnF-MrrwMadnwqrurKpkla9nE (Premium)
# FRAGMENT_ALLOWED_DESTINATIONS=

# --- Telegram bot ---
# Token from @BotFather
BOT_TOKEN=123456789:AA...
# or a file:  BOT_TOKEN_FILE=bot_token
# Telegram ids of shop admins (admin panel, test payments), comma separated (send /myid to the bot)
BOT_ADMIN_IDS=

# --- shop ---
# Starting values; afterwards they are changed in the admin panel and stored in the database
SHOP_MARKUP_PERCENT=10
SHOP_USD_RUB=95
# Stars per order: packages outside these limits are hidden (changeable in /admin)
SHOP_STARS_MIN=100
SHOP_STARS_MAX=10000
# Max unpaid / expired / failed orders per client in 24 h (0 = no limit; admins are exempt)
SHOP_ORDER_LIMIT_PER_DAY=5
# Your own payment providers (bot/payments/__init__.py REGISTRY), comma separated, in button order.
# RollyPay and xRocket are enabled by their API keys below; leave empty if you have no others.
PAYMENT_PROVIDERS=
# Minutes before an order expires if no payment link was created yet
# (with a RollyPay link the order expires together with the link)
PAYMENT_TIMEOUT_MIN=10
# SQLite database with orders (git-ignored)
BOT_DB_PATH=bot.db

# --- RollyPay (https://docs.rollypay.io) ---
# API key of the RollyPay terminal. Empty = RollyPay is not offered.
ROLLYPAY_API=
# true = sandbox payments ("test": true): free, paid by a button on the payment page.
# The bot still buys the order on Fragment with REAL TON, so in test mode RollyPay is shown to admins only.
ROLLYPAY_TEST=false
# polling = the bot asks RollyPay every ROLLYPAY_POLL_INTERVAL seconds;
# webhook = RollyPay notifies the bot (needs a public HTTPS URL set as callback_url of the terminal)
ROLLYPAY_MODE=polling
ROLLYPAY_POLL_INTERVAL=30
# webhook mode only: signing_secret of the terminal and the path the bot listens on
ROLLYPAY_SIGNING_SECRET=
ROLLYPAY_WEBHOOK_PATH=/webhooks/rollypay

# --- xRocket Pay (crypto via @xRocket), current Pay API: https://docs.xrocket.exchange ---
# API token of the app: @xRocket -> Pay API -> your app -> Settings -> API Token
# (the app must be on Settings -> API Version -> Current). Empty = xRocket is not offered.
XROCKET_API=
# true = testnet (@xrocket_testnet_bot, https://pay.api.testnet.xrocket.exchange) with its own token below.
# Testnet coins are free but the bot buys the order on Fragment with REAL TON -> admins only.
XROCKET_TESTNET=false
XROCKET_TESTNET_API=
# Currency of the invoice (USDT, USDC: 1:1 to the order's USD price; others e.g. GRAM=TON: by the xRocket rate)
XROCKET_CURRENCY=USDT
# Fixed fee added to the client's price, in XROCKET_CURRENCY (initial value; then changed in /admin)
XROCKET_FEE=0.5
# Invoice lifetime in seconds (60..86400); the order expires together with the invoice
XROCKET_EXPIRE_SECONDS=1800
# polling = the bot checks invoices every XROCKET_POLL_INTERVAL seconds; webhook = xRocket notifies the bot
XROCKET_MODE=polling
XROCKET_POLL_INTERVAL=30
# webhook mode: Webhook Token of the app (NOT the API token) for mainnet / testnet
XROCKET_WEBHOOK_SECRET=
XROCKET_TESTNET_WEBHOOK_SECRET=
# webhook mode: public HTTPS URL of the bot's endpoint, sent with every invoice (optional if the URL is set
# in the app settings in @xRocket); path the bot listens on
XROCKET_WEBHOOK_URL=
XROCKET_WEBHOOK_PATH=/webhooks/xrocket

# --- webhook server (RollyPay and xRocket in webhook mode share it) ---
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
